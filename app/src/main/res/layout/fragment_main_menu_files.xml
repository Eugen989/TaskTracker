<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            style="@style/DefaultMaterialButton"
            android:id="@+id/btnPersonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="Личные"
            android:background="@drawable/shape_button_active_square"
            app:backgroundTint="@null"
            app:icon="@drawable/icon_lock_on"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            style="@style/DefaultMaterialButton"
            android:id="@+id/btnShared"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="Общие"
            android:background="@drawable/shape_button_no_active_square"
            app:backgroundTint="@null"
            app:icon="@drawable/icon_lock_off"
            app:iconGravity="textStart" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                style="@style/DefaultMaterialButton"
                android:id="@+id/btnAllDrawings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Все рисунки"
                android:textAlignment="textStart"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="textEnd" />

            <LinearLayout
                android:id="@+id/allDrawingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                style="@style/DefaultMaterialButton"
                android:id="@+id/btnFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Избранные"
                android:textAlignment="textStart"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="textEnd" />

            <LinearLayout
                android:id="@+id/favoritesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                style="@style/DefaultMaterialButton"
                android:id="@+id/btnDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Документы"
                android:textAlignment="textStart"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="textEnd" />

            <LinearLayout
                android:id="@+id/documentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                style="@style/DefaultMaterialButton"
                android:id="@+id/btnDrawings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Рисунки"
                android:textAlignment="textStart"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="textEnd" />

            <LinearLayout
                android:id="@+id/drawingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>