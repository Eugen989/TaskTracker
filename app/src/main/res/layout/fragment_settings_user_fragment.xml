<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мой аккаунт" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mbAccountBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_item_square"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Аккаунт"
                android:textAlignment="textStart"
                app:backgroundTint="@color/invisible"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="end" />
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/accessory_70" />

            <com.google.android.material.button.MaterialButton
                android:visibility="gone"
                android:id="@+id/mbNotificationBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/shape_item_square"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Уведомления"
                android:textAlignment="textStart"
                app:backgroundTint="@color/invisible"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="end" />
            <View
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/accessory_70" />

            <com.google.android.material.button.MaterialButton
                android:visibility="gone"
                android:id="@+id/mbAdditionalFeaturesBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/shape_item_square"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Дополнительные возможности"
                android:textAlignment="textStart"
                app:backgroundTint="@color/invisible"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="end" />
            <View
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/accessory_70" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                style="@style/DefaultMaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_item_square"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Уведомления"
                android:textAlignment="textStart"
                app:backgroundTint="@color/invisible"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="end" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/accessory_70" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/DefaultMaterialButton"
            android:id="@+id/mbExitBand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_item_square"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Выйти"
            android:textAlignment="textStart"
            app:backgroundTint="@color/invisible"
            app:icon="@drawable/icon_exit" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>