<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:padding="12dp"
    android:orientation="horizontal"
    android:background="@drawable/shape_item_square">

    <TextView
        android:id="@+id/tvFileType"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="PNG"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/shape_file_type" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Имя файла"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFileDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01.01.2024"
            android:textSize="12sp"
            android:textColor="#888888" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnMenu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/icon_elipsis_vertical"
        android:layout_gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>