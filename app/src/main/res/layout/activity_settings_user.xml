<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbTitle"
        style="@style/DefaultMaterialButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Настройки"
        android:padding="8dp"
        app:icon="@drawable/icon_arrow_left"
        app:iconPadding="-16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/settingUserHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/mbTitle">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мой аккаунт" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                style="@style/DefaultMaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Аккаунт"
                android:textAlignment="textStart"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="end"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/accessory_70"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                style="@style/DefaultMaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Уведомления"
                android:textAlignment="textStart"
                app:icon="@drawable/icon_arrow_half_right"
                app:iconGravity="end"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/accessory_70"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/DefaultMaterialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Выйти"
            android:textAlignment="textStart"
            app:icon="@drawable/icon_exit"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>